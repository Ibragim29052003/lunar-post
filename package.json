{
  "name": "lunar-post",
  "version": "1.0.0",
  "description": "Лунная почта — авторская LCD-аркада по мотивам «Электроники»",
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "npm run typecheck && webpack --mode production",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,less}\" \"scripts/**/*.mjs\" \"*.{json,js,cjs,mjs,md}\" \"public/*.html\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,less}\" \"scripts/**/*.mjs\" \"*.{json,js,cjs,mjs,md}\" \"public/*.html\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "17.0.2",
    "@types/react-dom": "17.0.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "css-loader": "^6.5.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "html-webpack-plugin": "^5.6.8",
    "jsdom": "^27.4.0",
    "less": "4.2.0",
    "less-loader": "^11.1.4",
    "prettier": "^3.6.2",
    "style-loader": "^3.3.1",
    "ts-loader": "^9.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "webpack": "^5.92.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^6.1.0",
    "axe-core": "^4.11.0"
  },
  "private": true,
  "dependencies": {
    "classnames": "^2.3.2",
    "react": "17.0.2",
    "react-dom": "17.0.2"
  },
  "engines": {
    "node": "^22.15.0 || ^24.0.0 || >=26.0.0"
  }
}
